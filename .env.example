# PRIME OS — environment config
# Copy to .env and fill in your values

# Optional: your Anthropic API key — only needed to run agents.
# Projects, knowledge graph, and resources all work without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: where PRIME stores all data (default: ~/PRIME)
PRIME_WORKSPACE=~/PRIME

# Optional: server bind address and port
PRIME_HOST=127.0.0.1
PRIME_PORT=7474
