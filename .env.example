# PRIME OS — environment config
# Copy to .env and fill in your values

# ── LLM model ──────────────────────────────────────────────────────────────────
# LiteLLM model string. Provider is inferred from the prefix.
# Anthropic (cloud):  claude-sonnet-4-6  claude-opus-4-7
# Ollama (local):     ollama/llama3.1    ollama/mistral    ollama/qwen2.5-coder
# OpenAI (cloud):     gpt-4o             gpt-4o-mini
PRIME_MODEL=claude-sonnet-4-6

# ── Provider credentials ───────────────────────────────────────────────────────
# Only the key for your chosen provider is needed.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Ollama runs locally — no key needed.
# Set base URL only if Ollama is not on localhost:11434.
# OLLAMA_API_BASE=http://localhost:11434

# ── Server ─────────────────────────────────────────────────────────────────────
PRIME_HOST=127.0.0.1
PRIME_PORT=7474

# ── Optional API key guard ─────────────────────────────────────────────────────
# Set to require X-API-Key header on all /api routes.
# Leave empty (default) to run without auth — suitable for local-only use.
PRIME_API_KEY=
